{
  "board": {
    "ipc2581": { "sch_revision": "B" }
  },
  "schematic": {
    "bom_export_filename": "manufacturing/bom/${PROJECTNAME}.csv",
    "bom_fmt_settings": {
      "field_delimiter": ",",
      "string_delimiter": "\"",
      "ref_delimiter": ",",
      "ref_range_delimiter": "",
      "keep_tabs": false,
      "keep_line_breaks": false
    },
    "bom_settings": {
      "group_symbols": true,
      "exclude_dnp": false,
      "include_excluded_from_bom": false,
      "sort_asc": true,
      "sort_field": "Reference",
      "fields_ordered": [
        { "name": "${ITEM_NUMBER}", "show": true, "group_by": false },
        { "name": "${QUANTITY}", "show": true, "group_by": false },
        { "name": "Reference", "show": true, "group_by": false },
        { "name": "Value", "show": true, "group_by": true },
        { "name": "Tolerance", "show": true, "group_by": true },
        { "name": "Footprint", "show": true, "group_by": true },
        { "name": "Temp. Co.", "show": true, "group_by": true },
        { "name": "Voltage", "show": true, "group_by": true },
        { "name": "${DNP}", "show": true, "group_by": true },
        { "name": "OEPS PN", "show": true, "group_by": true },
        { "name": "MPN", "show": true, "group_by": true },
        { "name": "OEPS Description", "show": true, "group_by": true }
      ]
    }
  }
}
