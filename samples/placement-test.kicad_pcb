(kicad_pcb
  (version 20260206)
  (generator "pcbnew")
  (general (thickness 1.6))
  (paper "A4")
  (layers (0 "F.Cu" signal) (2 "B.Cu" signal))
  (setup (pad_to_mask_clearance 0) (aux_axis_origin 10 20)
    (pcbplotparams
      (outputdirectory "manufacturing/gerber/")
      (plotframeref no)
      (subtractmaskfromsilk yes)
      (hidednponfab no)
      (sketchdnponfab yes)
      (crossoutdnponfab yes)
      (sketchpadsonfab no)
      (plotpadnumbers no)
      (drillshape 0)
      (scaleselection 1)
      (useauxorigin yes)
      (mirror no)
      (psnegative no)
      (usegerberextensions no)
      (creategerberjobfile no)
      (usegerberattributes yes)
      (usegerberadvancedattributes yes)
      (disableapertmacros no)))
  (footprint "Test:SMD" (layer "F.Cu") (at 15 25)
    (property "Reference" "S1" (at 0 0) (layer "F.Cu"))
    (property "Value" "SMD" (at 0 1) (layer "F.Cu"))
    (attr smd)
    (pad "1" smd rect (at 0 0) (size 1 1) (layers "F.Cu")))
  (footprint "Test:THT" (layer "F.Cu") (at 16 26)
    (property "Reference" "T1" (at 0 0) (layer "F.Cu"))
    (property "Value" "Through hole" (at 0 1) (layer "F.Cu"))
    (attr through_hole)
    (pad "1" thru_hole circle (at 0 0) (size 2 2) (drill 1) (layers "*.Cu")))
  (footprint "Test:DNP" (layer "F.Cu") (at 17 27)
    (property "Reference" "D1" (at 0 0) (layer "F.Cu"))
    (property "Value" "DNP" (at 0 1) (layer "F.Cu"))
    (attr smd dnp)
    (pad "1" smd rect (at 0 0) (size 1 1) (layers "F.Cu")))
  (footprint "Test:ExcludedBOM" (layer "F.Cu") (at 18 28)
    (property "Reference" "E1" (at 0 0) (layer "F.Cu"))
    (property "Value" "Excluded from BOM" (at 0 1) (layer "F.Cu"))
    (attr smd exclude_from_bom)
    (pad "1" smd rect (at 0 0) (size 1 1) (layers "F.Cu")))
  (footprint "Test:Bottom" (layer "B.Cu") (at 19 29)
    (property "Reference" "B1" (at 0 0) (layer "B.Cu"))
    (property "Value" "Bottom" (at 0 1) (layer "B.Cu"))
    (attr smd)
    (pad "1" smd rect (at 0 0) (size 1 1) (layers "B.Cu")))
)
